# Development placeholders only. Replace the secrets before deploying.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://secureauth:secureauth@localhost:5432/secureauth?schema=public
JWT_ACCESS_SECRET=development_access_secret_change_me_1234567890
JWT_REFRESH_SECRET=development_refresh_secret_change_me_0987654321
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Used by docker-compose.yml; keep in sync with DATABASE_URL.
POSTGRES_USER=secureauth
POSTGRES_PASSWORD=secureauth
POSTGRES_DB=secureauth
