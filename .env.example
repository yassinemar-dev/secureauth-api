# Development placeholders only. Replace the secrets before deploying.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://secureauth:secureauth@localhost:5432/secureauth?schema=public
JWT_ACCESS_SECRET=development_access_secret_change_me_1234567890
JWT_REFRESH_SECRET=development_refresh_secret_change_me_0987654321
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Absolute refresh-session lifetime. Must be >= JWT_REFRESH_TTL.
MAX_SESSION_AGE=30d

# Optional hardening settings.
# Default rate window in milliseconds and maximum hits per window.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
# Comma-separated exact origins; empty means no cross-origin requests. "*" is rejected.
CORS_ORIGINS=
# "false" (do not trust X-Forwarded-For) or a positive proxy hop count. "true" is rejected.
TRUST_PROXY=false

# Used by docker-compose.yml; keep in sync with DATABASE_URL.
POSTGRES_USER=secureauth
POSTGRES_PASSWORD=secureauth
POSTGRES_DB=secureauth
POSTGRES_PORT=5432
